+        // The TryFindPeripheralAccessMethods fast path: a small
+        // per-address-page cache of resolved access methods, so the
+        // dominant same-peripheral access streaks (interrupt-controller
+        // words, timer counter polls) skip the per-access context
+        // resolution, dictionaries and locks. Entries are immutable
+        // objects swapped by volatile reference, so a reader can never
+        // observe a torn entry; a version stamp bumped on any peripheral
+        // collection change (registration, move, removal, per-context
+        // changes) invalidates every entry at once. A stale version can
+        // only cause a re-resolve, never a wrong hit.
+        // diagnostics for the access cache, readable from the monitor:
+        // sysbus FindCacheStats
+        public string FindCacheStats => $"hits={findHits} misses={findMisses} invalidations={findInvalidations} version={findAccessVersion} hasCtx={hasContextRegistrations}";
+        [Transient]
+        internal long findHits;
+        [Transient]
+        internal long findMisses;
+        [Transient]
+        internal long findInvalidations;
+
+        internal void InvalidateFindAccessCache()
+        {
+            findInvalidations++;
+            // With per-context (per-CPU) registrations present, a
+            // context==null lookup resolves through the CURRENT cpu, so
+            // a null-keyed cache entry could alias across cpus - forbid
+            // caching those on such machines. Computed here, off the
+            // hot path; conservative (true) when the collections are
+            // not yet constructed. Updated BEFORE the version bump so
+            // a lookup that sees the new version also sees the new flag.
+            try
+            {
+                hasContextRegistrations =
+                    peripheralsCollectionByContext.GetAllContextKeys().Any(x => x != null);
+            }
+            catch(NullReferenceException)
+            {
+                hasContextRegistrations = true;
+            }
+            findAccessVersion++;
+        }
+
+        private volatile bool hasContextRegistrations = true;
+
+        internal sealed class FindAccessCacheEntry
+        {
+            public int Version;
+            public IPeripheral Context;
+            public ulong? CpuState;
+            public ulong Start;
+            public ulong End;
+            public ulong Offset;
+            public PeripheralAccessMethods Methods;
+        }
+
+        // [Transient]: the cached PeripheralAccessMethods delegates must
+        // not be serialized; a fresh array simply refills on first use
+        [Transient]
+        internal FindAccessCacheEntry[] findAccessCache;
+        internal volatile int findAccessVersion;
+
         // Nearly no tag overrides peripheral accesses, yet the
         // generated access path consulted the tag list on every bus
         // access just in case one did. The count is recomputed lazily
