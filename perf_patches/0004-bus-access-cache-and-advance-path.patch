+            accessMethods = peripheralsCollectionByContext[null].FindAccessMethods(address, out startAddress, out endAddress, out offset);
+            if(accessMethods != null && (contextIn == null ? !hasContextRegistrations : true))
+            {
+                cache[slot] = new FindAccessCacheEntry
+                {
+                    Version = version, Context = contextIn, CpuState = cpuState,
+                    Start = startAddress, End = endAddress, Offset = offset, Methods = accessMethods,
+                };
+            }
             return accessMethods != null;
         }
     }
