+        // Looks up a clock entry index by handler through a lazily
+        // maintained dictionary instead of a linear delegate-equality
+        // scan. The scan is on the hot path of every peripheral timer
+        // register read (LimitTimer.Value -> GetClockEntry) and its cost
+        // scales with the number of clock entries; profiled at ~49% of
+        // the emulation thread for an STM32 firmware polling a timer
+        // counter for its microsecond clock. The dictionary is rebuilt
+        // whenever it is missing (fresh deserialization), its size
+        // disagrees with the list (any add/remove path) or a hit fails
+        // verification (an in-place handler exchange), so every mutation
+        // path self-heals without bookkeeping at the mutation sites.
+        private int FindEntryIndexByHandler(Action handler)
+        {
+            if(handlerToEntryIndex == null || handlerToEntryIndex.Count != clockEntries.Count)
+            {
+                RebuildHandlerToEntryIndex();
+            }
+            int i;
+            if(handlerToEntryIndex.TryGetValue(handler, out i) && clockEntries[i].Handler == handler)
+            {
+                return i;
+            }
+            RebuildHandlerToEntryIndex();
+            return handlerToEntryIndex.TryGetValue(handler, out i) ? i : -1;
+        }
+
+        private void RebuildHandlerToEntryIndex()
+        {
+            if(handlerToEntryIndex == null)
+            {
+                handlerToEntryIndex = new Dictionary<Action, int>();
+            }
+            else
