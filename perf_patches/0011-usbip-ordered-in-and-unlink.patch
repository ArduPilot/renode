+        // the host gives an unlinked URB back itself, and treats a later
+        // reply to it as a protocol error, so drop those replies
+        private void SendURBReply(Dictionary<uint, CancellationTokenSource> urbs, uint sequenceNumber, IEnumerable<byte> reply)
+        {
+            lock(replySync)
+            {
+                if(urbs.Remove(sequenceNumber))
+                {
+                    SendResponse(reply);
+                }
+            }
+        }
+
+        private void ForgetUrb(Dictionary<uint, CancellationTokenSource> urbs, uint sequenceNumber, CancellationTokenSource urbCancel)
+        {
+            lock(replySync)
+            {
+                if(urbs.TryGetValue(sequenceNumber, out var tracked) && tracked == urbCancel)
+                {
+                    urbs.Remove(sequenceNumber);
+                }
+            }
+            urbCancel.Dispose();
+        }
+
+        private void HandleUnlink(URBHeader header)
+        {
+            // CMD_UNLINK carries the sequence number of the URB to unlink
+            // where CMD_SUBMIT carries its transfer flags
+            var unlinkedSequenceNumber = header.FlagsOrStatus;
+            lock(replySync)
+            {
+                var pending = pendingUrbs.TryGetValue(unlinkedSequenceNumber, out var urbCancel);
+                if(pending)
+                {
+                    pendingUrbs.Remove(unlinkedSequenceNumber);
+                    urbCancel?.Cancel();
+                }
+                this.Log(LogLevel.Debug, "Unlinking URB 0x{0:X}: {1}", unlinkedSequenceNumber,
+                    pending ? "cancelled" : "already completed");
+                var reply = new URBHeader
+                {
+                    Command = URBCommand.UnlinkReply,
+                    SequenceNumber = header.SequenceNumber,
+                    FlagsOrStatus = pending ? unchecked((uint)-ConnectionResetError) : 0,
+                };
+                SendResponse(Packet.Encode(reply).Concat(Packet.Encode(new URBReply())));
+            }
         }
 
