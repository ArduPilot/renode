+using NUnit.Framework;
+
+namespace Antmicro.Renode.PeripheralsTests
+{
+    [TestFixture]
+    public class STM32_GPIOPortTests
+    {
+        [Test]
+        public void ShouldResolveOutputAndInputModesImmediately()
+        {
+            var gpio = new STM32_GPIOPort(new Machine());
+
+            gpio.WriteDoubleWord(OutputData, 1);
+            Assert.True((gpio.ReadDoubleWord(OutputData) & 1) != 0);
+            Assert.False(gpio.Connections[0].IsSet);
+
+            gpio.OnGPIO(0, true);
+            Assert.True(gpio.Connections[0].IsSet);
+
+            gpio.WriteDoubleWord(Mode, OutputMode);
+            Assert.True(gpio.Connections[0].IsSet);
+            gpio.OnGPIO(0, false);
+            Assert.True(gpio.Connections[0].IsSet);
+
+            gpio.WriteDoubleWord(Mode, InputMode);
+            Assert.False(gpio.Connections[0].IsSet);
+        }
+
+        [Test]
+        public void ShouldRememberInactiveAlternateFunctionLevels()
+        {
+            var gpio = new STM32_GPIOPort(new Machine());
+            var alternateFunction = gpio.GetLocalReceiver(0);
+
+            alternateFunction.OnGPIO(3, true);
+            gpio.WriteDoubleWord(Mode, AlternateFunctionMode);
+            Assert.False(gpio.Connections[0].IsSet);
+
+            gpio.WriteDoubleWord(AlternateFunctionLow, 3);
